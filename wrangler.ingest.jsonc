{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "signal13f-ingestion",
  "main": "worker/ingest.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SEC_USER_AGENT": "Signal13F holdings monitor kkertin1214@gmail.com"
  },
  "kv_namespaces": [
    {
      "binding": "PORTFOLIO_SNAPSHOTS",
      "id": "b20d4fe0236a4a9aabe1e6e01e782df2"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INGEST_QUEUE",
        "queue": "signal13f-ingestion"
      }
    ],
    "consumers": [
      {
        "queue": "signal13f-ingestion",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 8,
        "max_concurrency": 1,
        "retry_delay": 300
      }
    ]
  },
  "triggers": {
    "crons": ["10 * 11-18 2,5,8,11 *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
